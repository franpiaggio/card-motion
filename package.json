{
  "name": "card-motion-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for card-motion — Balatro-style card animations for React.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter card-motion build",
    "dev": "pnpm --filter playground dev",
    "playground": "pnpm --filter playground dev",
    "typecheck": "pnpm -r typecheck",
    "release": "pnpm --filter card-motion publish"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
