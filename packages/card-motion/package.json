{
  "name": "card-motion",
  "version": "0.3.2",
  "description": "Toolkit to prototype, design and ship browser card games: named piles, deal/shuffle, drag & drop, inspect, layouts and juicy GSAP card animation. You write the rules; it runs the table. React + framework-free TypeScript. Agent-friendly (ships llms.txt).",
  "keywords": [
    "card-game",
    "card-games",
    "browser-game",
    "game-prototyping",
    "prototype",
    "game-design",
    "game-development",
    "deckbuilder",
    "solitaire",
    "tcg",
    "ccg",
    "playing-cards",
    "cards",
    "deck",
    "shuffle",
    "drag-and-drop",
    "animation",
    "gsap",
    "react",
    "vanilla",
    "typescript",
    "webgl",
    "ai-agents",
    "llms-txt"
  ],
  "license": "MIT",
  "author": "Francisco Piaggio",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "llms.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "gsap": ">=3.12",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gsap": "^3.12.5",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
